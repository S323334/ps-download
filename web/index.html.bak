                            <div id="hsCardTags" style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;">
                                <span class="tag-pill" style="background:rgba(99,102,241,0.2); color:#a5b4fc; border:1px solid rgba(99,102,241,0.4); padding:2px 8px; border-radius:6px; font-size:0.75rem;">1080p FHD</span>
                            </div>
