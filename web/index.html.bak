    <!-- YouTube Downloader View -->
    <div id="youtubeView" class="youtube-view-container" style="display:none;">
        <div class="yt-content-wrapper">
            <!-- Hero Card -->
            <div class="yt-hero-banner">
                <div class="yt-hero-glow"></div>
                <div class="yt-hero-content">
                    <h1 class="yt-hero-title">
                        <span class="yt-title-red">YouTube</span> Downloader
                    </h1>
                    <p class="yt-hero-subtitle" id="ytHeroSubtitle">
                        ទាញយកវីដេអូ YouTube គុណភាពខ្ពស់បំផុត (4K, 1440p, 1080p60 & MP3 320kbps) ដោយមិនបាត់បង់គុណភាព
                    </p>

                    <!-- URL Input Box -->
                    <div class="yt-search-box-card">
                        <div class="yt-search-input-wrapper">
                            <span class="yt-input-icon">
                                <svg viewBox="0 0 24 24" width="22" height="22">
                                    <path fill="#FF0000" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/>
                                    <polygon fill="#FFFFFF" points="9.545,15.568 15.818,12 9.545,8.432"/>
                                </svg>
                            </span>
                            <input type="text" id="ytUrlInput" class="yt-main-input" placeholder="បិទភ្ជាប់លីង YouTube (Paste link: https://www.youtube.com/watch?v=... ឬ Shorts)" onkeydown="onYtInputKeyDown(event)" onpaste="handleYtUrlPaste(event)" oninput="handleYtUrlInput(this.value)" autocomplete="off" spellcheck="false">
                        </div>
                        <div class="yt-search-buttons">
                            <button type="button" class="btn yt-btn-paste" onclick="pasteYtFromClipboard()" title="Paste URL">
                                <span>📋</span> <span id="ytPasteBtnLabel">Paste URL</span>
                            </button>
                            <button type="button" class="btn yt-btn-analyze" id="btnYtAnalyze" onclick="analyzeCurrentYtUrl()">
                                <span class="yt-btn-spinner" id="ytAnalyzeSpinner" style="display:none;">⏳</span>
                                <span id="ytAnalyzeBtnText">⚡ វិភាគវីដេអូ (Fetch)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Quick hints / Tags -->
                    <div class="yt-hints-row">
                        <span class="yt-hint-label" id="ytHintLabel">គាំទ្រ:</span>
                        <span class="yt-hint-chip" id="ytHintWatch">🎬 វីដេអូទូទៅ (Watch)</span>
                        <span class="yt-hint-chip" id="ytHintShorts">⚡ YouTube Shorts</span>
                        <span class="yt-hint-chip" id="ytHintLink">🔗 youtu.be Link</span>
                        <span class="yt-hint-chip" id="ytHintMusic">🎵 YouTube Music</span>
                    </div>
                </div>
            </div>

            <!-- Video Details Card (Appears after analysis) -->
            <div id="ytVideoCard" class="yt-video-card" style="display:none;">
                <div class="yt-card-preview-col">
                    <div class="yt-thumb-wrapper">
                        <img id="ytCardThumb" src="" alt="Thumbnail" class="yt-card-thumb">
                        <span class="yt-duration-badge" id="ytCardDuration">00:00</span>
                        <span class="yt-maxres-badge" id="ytCardMaxRes">🌟 4K UHD</span>
                    </div>
                </div>

                <div class="yt-card-info-col">
                    <h3 class="yt-card-title" id="ytCardTitle">Video Title</h3>
                    
                    <div class="yt-meta-row">
                        <span class="yt-channel-badge">
                            <span class="yt-channel-icon">👤</span>
                            <span id="ytCardChannel">Channel Name</span>
                        </span>
                        <span class="yt-meta-pill" id="ytCardViews">👁️ 0 views</span>
                        <span class="yt-meta-pill" id="ytCardDate">📅 Recent</span>
                    </div>

                    <!-- Quality Selector -->
                    <div class="yt-quality-section">
                        <div class="yt-quality-label-row">
                            <span class="yt-section-title" id="ytQualitySelectTitle">🎯 ជ្រើសរើសកម្រិតច្បាស់ (Resolution & Quality):</span>
                            <span class="yt-quality-badge-tip" id="ytQualityTip">ច្បាស់បំផុត / Highest Bitrate</span>
                        </div>
                        <div class="yt-quality-chips-grid" id="ytQualityGrid">
                            <!-- Quality options injected via JS -->
                        </div>
                    </div>

                    <!-- Output location info -->
                    <div class="yt-output-location-row">
                        <div class="yt-location-text">
                            <span id="ytOutputDirLabel">📁 រក្សាទុកនៅ:</span>
                            <code id="ytOutputDirDisplay">...\Videos\Hongguo Downloads\YouTube</code>
                        </div>
                        <button type="button" class="btn btn-secondary yt-btn-sm" onclick="browseYouTubeFolder()" title="ផ្លាស់ប្ដូរ Folder">
                            <span id="ytChangeFolderBtnText">📁 ប្ដូរ Folder</span>
                        </button>
                    </div>

                    <!-- Action Row -->
                    <div class="yt-action-row">
                        <button type="button" class="btn yt-btn-download-primary" id="btnStartYtDownload" onclick="startCurrentYtDownload()">
                            <span>📥</span> <span id="ytDownloadBtnText">ចាប់ផ្ដើមទាញយកឥឡូវនេះ (Download Now)</span>
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="openYouTubeFolder()" title="បើក Folder">
                            <span id="ytOpenFolderBtnText">📂 បើក Folder</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- YouTube Download Tasks / History Section -->
            <div class="yt-tasks-section">
                <div class="yt-tasks-header">
                    <div class="yt-tasks-title-wrap">
                        <h3 id="ytTasksHeaderTitle">📋 បញ្ជីទាញយក YouTube (YouTube Downloads)</h3>
                        <span class="badge" id="ytTasksBadge" style="display:none;">0</span>
                    </div>
                    <div class="yt-tasks-actions">
                        <button type="button" class="btn btn-secondary yt-btn-sm" onclick="clearFinishedYtTasks()" title="សម្អាតទាញយករួចរាល់">
                            <span id="ytClearFinishedBtnText">🗑️ សម្អាតដែលចប់</span>
                        </button>
                        <button type="button" class="btn btn-secondary yt-btn-sm" onclick="openYouTubeFolder()" title="បើក Folder YouTube ក្នុង Explorer">
                            <span id="ytOpenTasksFolderBtnText">📂 បើក Folder YouTube</span>
                        </button>
                    </div>
                </div>

                <!-- Empty State -->
                <div id="ytEmptyTasks" class="yt-empty-tasks">
                    <div class="yt-empty-icon">▶️</div>
                    <h4 id="ytEmptyTasksTitle">មិនទាន់មានវីដេអូកំពុងទាញយកនៅឡើយទេ</h4>
                    <p id="ytEmptyTasksSub">បិទភ្ជាប់លីង YouTube ខាងលើ រួចចុច "វិភាគវីដេអូ" ដើម្បីចាប់ផ្ដើមទាញយកកម្រិត 4K ឬ MP3</p>
                </div>

                <!-- Tasks List Container -->
                <div id="ytTasksContainer" class="yt-tasks-grid" style="display:none;">
                    <!-- Task cards injected via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- Drama Detail Modal -->
    <div class="modal-overlay" id="detailModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3 id="modalDramaTitle">ព័ត៌មានលម្អិតរឿង</h3>
                <button class="close-btn" onclick="closeDetailModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-layout">
                    <div class="detail-poster-area">
                        <div class="detail-poster">
                            <img id="modalCoverImg" src="" alt="Poster">
                        </div>
                        <a id="modalCoverDownloadLink" class="btn btn-secondary" style="text-align:center; justify-content:center;" target="_blank">
                            📥 ទាញយក Poster
                        </a>
                    </div>
                    <div class="detail-info">
                        <h2 id="modalTitleText">-</h2>
                        <div class="detail-meta-row" id="modalTagsRow"></div>
                        <p class="detail-desc" id="modalIntroText">-</p>

                        <!-- Range Selection -->
                        <div class="range-selector-box">
                            <div style="font-size:0.8rem; font-weight:700; color:var(--text-muted); margin-bottom:8px;">
                                ជ្រើសរើសភាគដើម្បីទាញយក (Episode Range):
                            </div>
                            <div class="range-quick-btns">
                                <button class="range-quick-btn active" onclick="setRangeQuick('all', this)">ភាគទាំងអស់ (All)</button>
                                <button class="range-quick-btn" onclick="setRangeQuick('free', this)">ភាគ Free (1-10)</button>
                                <button class="range-quick-btn" onclick="setRangeQuick('1-20', this)">ភាគ 1 - 20</button>
                                <button class="range-quick-btn" onclick="setRangeQuick('1-50', this)">ភាគ 1 - 50</button>
                            </div>
                            <div class="range-input-row">
                                <input type="text" class="range-input" id="customRangeInput" placeholder="ឧទាហរណ៍: 1-15, 20-35 ឬ all" value="all" oninput="updateRangeSelection()">
                                <button class="btn btn-secondary" style="padding:7px 12px; font-size:0.8rem;" onclick="selectAllEpisodes()">Select All</button>
                                <button class="btn btn-secondary" style="padding:7px 12px; font-size:0.8rem;" onclick="deselectAllEpisodes()">Clear</button>
                            </div>
                        </div>

                        <!-- Episode Grid -->
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <span style="font-size:0.82rem; font-weight:700; color:var(--text-muted);">បញ្ជីភាគ (<span id="selectedCountText">0</span> បានជ្រើសរើស):</span>
                            <span style="font-size:0.75rem; color:var(--text-dim);">ចុចលើភាគដើម្បីចាក់មើល</span>
                        </div>
                        <div class="modal-ep-grid" id="modalEpGrid"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeDetailModal()">បិទ (Close)</button>
                <div style="display:flex; gap:10px;">
                    <button class="btn btn-secondary" onclick="playFirstEpisode()">
                        <span>▶</span> មើលភាគទី ១
                    </button>
                    <button class="btn btn-primary" onclick="submitModalDownload()">
                        <span>📥</span> ចាប់ផ្ដើមទាញយក (<span id="submitBtnEpCount">All</span> ភាគ)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reference Ultimate Stream View Modal -->
<section class="view-stream" id="streamView" hidden onclick="handleStreamBackdropClick(event)">
      <div class="stream-modal-dialog" onclick="event.stopPropagation()">
        <!-- Stream Topbar -->
        <div class="stream-topbar">
          <div class="stream-topbar-left">
            <button class="btn-back" onclick="showHomeView()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
              <span id="btnStreamBackText">Back to Browse</span>
            </button>
            <span class="stream-modal-title" id="modalTopTitle"></span>
          </div>
          <div class="stream-topbar-right">
            <div class="resume-pill" id="resumeBadge">
              🕒 Resumed at Episode 1 of 100
            </div>
            <!-- Change Download Folder Button -->
            <button class="btn-modal-pip btn-stream-folder" id="btnStreamChangeFolder" onclick="changeDownloadFolderPrompt()"
              title="ជ្រើសរើស / ផ្លាស់ប្តូរ Folder រក្សាទុក (Change Download Folder: Drive C, D, etc.)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
              <span id="streamFolderBtnText">📁 ផ្លាស់ប្តូរ Folder</span>
            </button>
          </div>
        </div>

        <!-- Mini-Player Header Bar (Visible only in Mini-Player mode) -->
        <div class="mini-player-bar" id="miniPlayerBar">
          <div class="mini-title-wrap">
            <span class="mini-live-dot"></span>
            <span class="mini-title-text" id="miniTitleText">Drama</span>
            <span class="mini-ep-text" id="miniEpText">EP 1</span>
          </div>
          <div class="mini-actions">
            <button class="btn-mini-action" onclick="toggleNativePip(event)" title="Native OS Picture-in-Picture">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <rect x="12" y="8" width="8" height="6" rx="1" fill="currentColor"></rect>
              </svg>
            </button>
            <button class="btn-mini-action" onclick="expandFromMiniPlayer(event)" title="Expand to Full Player">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
            <button class="btn-mini-action btn-mini-close" onclick="showHomeView()" title="Close Player">✕</button>
          </div>
        </div>

        <div class="stream-layout">
          <!-- Left Column: Video Player & Metadata -->
          <div class="stream-left">
            <div class="player-container" id="playerContainer" onmousemove="handlePlayerUserActivity()"
              ontouchstart="handlePlayerUserActivity()" onmouseleave="handlePlayerMouseLeave()">
              <!-- Video Screen Stage -->
              <div class="video-stage">
                <video id="videoPlayer" preload="metadata" playsinline webkit-playsinline="true" x5-playsinline="true"
                  x5-video-player-type="h5" controlslist="nodownload noplaybackrate"></video>

                <!-- Smart Double-Tap & Double-Click Seek Touch Zones (Left 40%, Center 20%, Right 40%) -->
                <div class="player-touch-zones" id="playerTouchZones" onclick="handlePlayerAreaClick(event)"
                  ontouchend="handlePlayerTouchEnd(event)">
                  <!-- Left Seek Zone (Rewind -10s) -->
                  <div class="player-touch-zone-left" id="zoneLeft">
                    <div class="seek-feedback-overlay-left" id="seekFeedbackLeft" style="display: none;">
                      <div class="seek-feedback-chip">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                          <path d="M3 3v5h5" />
                        </svg>
                        <span id="seekFeedbackTextLeft">-10s</span>
                      </div>
                    </div>
                  </div>

                  <!-- Center Tap Zone (Play/Pause) -->
                  <div class="player-touch-zone-center"></div>

                  <!-- Right Seek Zone (Fast Forward +10s) -->
                  <div class="player-touch-zone-right" id="zoneRight">
                    <div class="seek-feedback-overlay-right" id="seekFeedbackRight" style="display: none;">
                      <div class="seek-feedback-chip">
                        <span id="seekFeedbackTextRight">+10s</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                          <path d="M21 3v5h-5" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Loading Spinner / Buffering Overlay -->
                <div class="player-buffering-overlay" id="playerBufferingOverlay"
                  style="display:none;position:absolute;inset:0;background:rgba(10,14,23,0.7);backdrop-filter:blur(3px);flex-direction:column;align-items:center;justify-content:center;z-index:25;pointer-events:none;">
                  <div class="spinner"
                    style="width:44px;height:44px;border-width:3.5px;border-color:rgba(255,255,255,0.2);border-top-color:var(--orange);">
                  </div>
                  <span style="font-size:12px;font-weight:700;color:#f8fafc;margin-top:12px;letter-spacing:0.5px;">⚡
                    Preparing Decrypted Stream...</span>
                </div>

                <!-- Large Glowing Center Play Button Overlay on Pause -->
                <div class="player-center-play-overlay" id="centerPlayOverlay" onclick="togglePlay(event)">
                  <button class="player-center-play-btn" id="centerPlayBtn" title="Play">
                    <svg viewBox="0 0 24 24">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </button>
                </div>

                <!-- In-Player Episode Drawer Sheet -->
                <div class="player-ep-drawer hidden" id="playerEpDrawer">
                  <div class="player-ep-drawer-header">
                    <div style="display:flex;align-items:center;gap:8px;">
                      <span style="color:#fbbf24;font-size:1.1rem;font-weight:800;">≡</span>
                      <div>
                        <h4 style="margin:0;font-size:0.9rem;font-weight:800;color:#ffffff;" id="drawerSeriesTitle">All
                          Episodes</h4>
                        <div style="font-size:0.7rem;color:#94a3b8;" id="drawerSubtitle">Select an episode to play</div>
                      </div>
                    </div>
                    <button type="button" onclick="toggleEpisodeDrawer(event)"
                      style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);color:#ffffff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;"
                      title="Close">✕</button>
                  </div>
                  <div class="player-ep-drawer-grid" id="playerDrawerGrid"></div>
                </div>
              </div>

              <!-- Bottom Floating Player Controls Bar -->
              <div class="player-controls-bar" id="playerControlsBar" onmousemove="handlePlayerUserActivity()" onclick="event.stopPropagation()">
                <!-- Timeline Scrub Bar with Amber Accent -->
                <div class="player-timeline-container" id="playerTimelineContainer">
                  <input type="range" class="player-timeline-range" id="timelineRange" min="0" max="100" step="0.1"
                    value="0" oninput="handleTimelineSeek(this.value)">
                </div>

                <!-- Controls Buttons Row -->
                <div class="player-controls-row">
                  <div class="player-controls-left">
                    <!-- Prev Episode -->
                    <button class="player-btn" onclick="prevEpisode(event)" id="btnPrevEp" title="Previous Episode">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="19 20 9 12 19 4 19 20"></polygon>
                        <line x1="5" y1="19" x2="5" y2="5"></line>
                      </svg>
                    </button>

                    <!-- Play / Pause -->
                    <button class="player-btn" id="ctrlPlayBtn" onclick="togglePlay(event)" title="Play / Pause">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                    </button>

                    <!-- Next Episode -->
                    <button class="player-btn" onclick="nextEpisode(event)" id="btnNextEp" title="Next Episode">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="5 4 15 12 5 20 5 4"></polygon>
                        <line x1="19" y1="5" x2="19" y2="19"></line>
                      </svg>
                    </button>

                    <!-- Volume & Mute -->
                    <div class="player-volume-group" id="playerVolGroup">
                      <button class="player-btn" onclick="toggleMute(event)" id="muteBtn" title="Mute / Unmute">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                      </button>
                      <input type="range" class="player-volume-slider" id="volSlider" min="0" max="1" step="0.05"
                        value="1" oninput="changeVolume(this.value, event)">
                    </div>

                    <!-- Timestamp Display -->
                    <span class="player-time-display" id="timeDisplay">0:00 / 0:00</span>
                  </div>

                  <div class="player-controls-right">
                    <!-- Episode Selector Badge Button (opens in-player drawer) -->
                    <button class="player-ep-badge-btn" id="playerEpBadgeBtn" onclick="toggleEpisodeDrawer(event)"
                      title="Select Episode">
                      <span>≡</span>
                      <span id="playerEpBadgeText">EP 1</span>
                      <span style="font-size:0.65rem;margin-left:2px;">▲</span>
                    </button>

                    <!-- Video Quality Track Dropdown -->
                    <select class="player-quality-select" id="playerQualitySelect"
                      onchange="selectQuality(this.value, event)" title="កម្រិតគុណភាពវីដេអូ">
                      <option value="360p">⚡ 360p (លឿន/Fast)</option>
                      <option value="480p">480p (ធម្មតា/SD)</option>
                      <option value="720p" selected>720p (ស្តង់ដារ HD)</option>
                      <option value="1080p">💎 1080p (ច្បាស់បំផុត FHD)</option>
                    </select>

                    <!-- Playback Speed Button -->
                    <button class="player-speed-btn" id="speedBtn" onclick="cycleSpeed(event)"
                      title="Playback Speed">1x</button>

                    <!-- Picture-in-Picture / Mini-Player Button -->
                    <button class="player-btn" id="btnPip" onclick="toggleMiniPlayer(true, event)"
                      title="Mini-Player / Picture-in-Picture (P)">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <rect x="12" y="9" width="8" height="6" rx="1" fill="currentColor"></rect>
                      </svg>
                    </button>

                    <!-- Fullscreen Button -->
                    <button class="player-btn" id="btnFullscreen" onclick="toggleFullscreen(event)"
                      title="Fullscreen (F)">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path
                          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3">
                        </path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Now Playing Header Box (Below Player) -->
            <div class="now-playing-box">
              <div class="now-meta-left">
                <div class="now-meta-tagline">
                  <span class="tag-now-ep" id="nowPlayingEpTag">NOW PLAYING • EPISODE 1</span>
                  <span class="tag-pill-free">100% FREE DRAMA</span>
                  <span class="tag-saved">✓ Saved Automatically</span>
                </div>
                <h2 class="now-ep-title" id="nowEpTitle">Episode 1</h2>
              </div>

              <div class="now-actions-right">
                <button class="btn-ghost-act" id="btnStreamQueue" onclick="queueCurrentSeries()"><span id="btnStreamQueueText">📥 + Queue Series</span></button>
                <button class="btn-ghost-act" id="btnStreamDownloadEp" onclick="downloadCurrentEpisode()"
                  title="Download current episode"><span id="btnStreamDownloadEpText">⬇️ Download Ep</span></button>
                <button class="btn-ghost-act" id="btnStreamPrevEp" onclick="prevEpisode()"><span id="btnStreamPrevEpText">⏮ Prev Ep</span></button>
                <button class="btn-orange-act" id="btnStreamNextEp" onclick="nextEpisode()"><span id="btnStreamNextEpText">Next Ep ⏭</span></button>
                <button class="btn-ghost-act" id="btnWatchlistAct" onclick="toggleCurrentWatchlist()">
                  <span id="watchlistIcon">🔖</span> <span id="watchlistBtnText">Watchlist</span>
                </button>
                <button class="btn-ghost-act" id="btnStreamShare" onclick="copyShareLink()"><span id="btnStreamShareText">🔗 Share</span></button>
              </div>
            </div>

            <!-- Drama Details Box -->
            <div class="drama-detail-box">
              <div class="detail-thumb">
                <img id="detailThumbImg"
                  src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='160' viewBox='0 0 120 160'><rect width='100%25' height='100%25' fill='%231a2233'/><circle cx='60' cy='80' r='22' fill='%23243048'/><path d='M55 70 L72 80 L55 90 Z' fill='%2364748b'/></svg>"
                  alt="" style="transition:opacity 0.25s ease;"
                  onerror="this.src='data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='160' viewBox='0 0 120 160'><rect width='100%25' height='100%25' fill='%231a2233'/><circle cx='60' cy='80' r='22' fill='%23243048'/><path d='M55 70 L72 80 L55 90 Z' fill='%2364748b'/></svg>'">
              </div>
              <div class="detail-body">
                <div class="detail-tags">
                  <span class="chip-status" id="detailStatusChip">Completed Series</span>
                </div>
                <h3 class="detail-title" id="detailTitle">Drama Title</h3>
                <p class="detail-sub" id="detailIntro">Synopsis...</p>
                <div class="detail-hashtags" id="detailHashtags">
                </div>
                <div class="detail-meta-stats">
                  <span id="detailTotalEps">🎬 100 Episodes</span>
                  <span id="detailViewCount">👁 266 Views</span>
                </div>
              </div>
            </div>

            <!-- Live Download Status & Progress Log Box in Player -->
            <div class="player-dl-log-panel" id="playerDownloadLogPanel">
              <div class="pdl-header">
                <div class="pdl-header-left">
                  <span class="pdl-badge-pulse" id="pdlLiveBadge" style="display:none;">● LIVE</span>
                  <span class="pdl-title" id="pdlTitleText">ដំណើរការទាញយក (Download Progress & Log)</span>
                  <span class="pdl-speed" id="pdlSpeedBadge">⚡ 0.0 MB/s</span>
                </div>
                <div class="pdl-header-right">
                  <span class="pdl-folder-chip" id="pdlFolderChip" onclick="openSystemDownloadFolder()" title="ចុចដើម្បីបើក Folder ក្នុង Windows (Click to Open Folder in Explorer)">
                    <span id="pdlFolderText">📁 Folder: D:\Hongguo</span>
                  </span>
                  <button type="button" class="pdl-min-btn" onclick="togglePlayerDownloadLog()" title="បិទ/បង្រួម / Minimize">✕</button>
                </div>
              </div>
              <div class="pdl-body">
                <div class="pdl-meta-row">
                  <div class="pdl-meta-item">
                    <span class="pdl-label" id="pdlSeriesLabel">រឿង / Series:</span>
                    <span class="pdl-val" id="pdlCurrentSeriesTitle">គ្មាន (Idle)</span>
                  </div>
                  <div class="pdl-meta-item">
                    <span class="pdl-label" id="pdlEpsLabel">ភាគ / Episodes:</span>
                    <span class="pdl-val" id="pdlEpisodeProgress">0 / 0</span>
                  </div>
                  <div class="pdl-meta-item">
                    <span class="pdl-label" id="pdlStatusLabel">ស្ថានភាព / Status:</span>
                    <span class="pdl-val pdl-val-status" id="pdlStatusText">Idle</span>
                  </div>
                </div>
                <div class="pdl-prog-bar-wrap">
                  <div class="pdl-prog-bar-fill" id="pdlProgressBar" style="width: 0%;"></div>
                </div>
                <div class="pdl-console-log" id="pdlConsoleLog">
                  <div class="pdl-log-line pdl-log-dim">[System] Download logger initialized. Ready.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Episode Grid Drawer -->
          <div class="stream-right">
            <div class="episodes-drawer">
              <div class="drawer-head">
                <div class="drawer-head-left">
                  <h3 id="drawerTotalTitle">Episodes (100 total)</h3>
                  <p id="drawerSubTitle">Complete Episode List</p>
                </div>
                <div class="auto-next-toggle">
                  <span id="drawerAutoNextLabel">Auto-Next</span>
                  <label class="switch">
                    <input type="checkbox" id="autoNextSwitch" checked>
                    <span class="slider"></span>
                  </label>
                </div>
              </div>

              <!-- Episode Filter Tabs -->
              <div class="drawer-tabs">
                <button class="ep-tab active" data-range="all" id="tabEpAll" onclick="filterDrawerEps('all')">All
                  (100)</button>
              </div>

              <!-- Batch Action Bar: Check All, Range Selector, Download Selected -->
              <div class="batch-controls-card">
                <div class="batch-row-top">
                  <button type="button" class="btn-batch-action" id="btnToggleCheckAll" onclick="toggleSelectAllEpisodes()">
                    <span id="checkAllIcon">☑️</span> <span id="checkAllText">គ្រីសទាំងអស់ (Select All)</span>
                  </button>
                  <button type="button" class="btn-batch-download" id="btnDownloadSelectedEps" onclick="downloadSelectedEpisodesBatch()">
                    <span>📥 <span id="btnBatchDlText">ទាញយកភាគដែលបានគ្រីស</span> (<b id="selectedEpisodesBadge">0</b>)</span>
                  </button>
                </div>
                <div class="batch-row-range">
                  <span class="range-text-label" id="rangeTextLabel">រើសភាគ:</span>
                  <input type="number" id="epRangeFrom" min="1" value="1" class="ep-range-input" placeholder="1" title="ចាប់ពីភាគ">
                  <span class="range-dash" id="rangeDashText">ដល់</span>
                  <input type="number" id="epRangeTo" min="1" value="20" class="ep-range-input" placeholder="20" title="ដល់ភាគ">
                  <button type="button" class="btn-range-apply" onclick="applyEpisodeRangeSelection()">
                    <span id="btnRangeApplyText">🎯 ចាប់ផ្ដើមគ្រីស</span>
                  </button>
                </div>
                <div id="dramaHistoryMemoryBadge" class="drama-memory-tag" style="display:none;"></div>
              </div>

              <!-- 4-Column Episode Tiles Grid -->
              <div class="ep-grid" id="epGrid"></div>

              <!-- VIP Top-up Banner Card -->
            </div>
          </div>
        </div>
    </section>

    <!-- Downloads Drawer & Unified Library Hub -->
    <div class="drawer-overlay" id="downloadsDrawer" onclick="if(event.target===this) toggleDownloadsDrawer()">
        <div class="drawer-content">
            <div class="drawer-header">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:1.3rem;">⬇️</span>
                    <h3 id="dlDrawerTitle" style="font-family:'Outfit', sans-serif; font-size:1.15rem;">គ្រប់គ្រងការទាញយក & បណ្ណាល័យ</h3>
                </div>
                <button class="close-btn" onclick="toggleDownloadsDrawer()">&times;</button>
            </div>

            <!-- Drawer View Tabs: Active vs Library -->
            <div class="drawer-tabs-nav">
                <button type="button" class="drawer-tab-btn active" id="drawerTabActive" onclick="switchDrawerTab('active')">
                    <span>⚡</span> <span id="drawerTabActiveText">កំពុងដំណើរការ</span>
                    <span class="badge" id="drawerActiveBadge" style="display:none; font-size:0.7rem; padding:1px 6px;">0</span>
                </button>
                <button type="button" class="drawer-tab-btn" id="drawerTabLibrary" onclick="switchDrawerTab('library')">
                    <span>📁</span> <span id="drawerTabLibText">បណ្ណាល័យបានទាញយក</span>
                    <span class="badge" id="drawerLibBadge" style="display:none; font-size:0.7rem; padding:1px 6px; background:#10b981;">0</span>
                </button>
            </div>

            <div class="drawer-body">
                <!-- 1. ACTIVE DOWNLOADS VIEW -->
                <div id="drawerActiveView" style="display:flex; flex-direction:column; gap:14px;">
                    <!-- Speed & Progress Meter -->
                    <div class="speed-panel">
                        <div class="speed-row">
                            <span id="dlLiveSpeedLabel" style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">ល្បឿនបច្ចុប្បន្ន:</span>
                            <span class="speed-val" id="dlLiveSpeed">0.0 MB/s</span>
                        </div>
                        <div class="speed-row" style="font-size:0.8rem; color:var(--text-dim); margin-bottom:8px;">
                            <span id="dlCurrentItem">Idle</span>
                            <span id="dlPercentText">0%</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" id="dlProgressFill"></div>
                        </div>
                        <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:0.75rem; color:var(--text-dim);">
                            <span id="dlDoneLabel">បានបញ្ចប់: <b id="dlTotalDone" style="color:#fff;">0</b> / <span id="dlTotalEps">0</span> <span id="dlDoneUnit">ភាគ</span></span>
                            <span id="dlRunningStatus" style="color:#fb7185;">Ready</span>
                        </div>
                    </div>

                    <!-- Empty State for Active Downloads -->
                    <div id="drawerActiveEmpty" style="display:none; text-align:center; padding:30px 14px; background:rgba(255,255,255,0.02); border-radius:10px; border:1px dashed var(--border-glass); color:var(--text-dim);">
                        <div style="font-size:2rem; margin-bottom:6px;">☕</div>
                        <div id="drawerActiveEmptyText" style="font-size:0.88rem; font-weight:600; color:#cbd5e1;">មិនមានវីដេអូកំពុងដំណើរការទាញយកទេ</div>
                        <div style="font-size:0.75rem; color:#64748b; margin-top:4px;">រឿងភាគ ឬ វីដេអូ YouTube ដែលកំពុងដោន នឹងបង្ហាញទីនេះដោយស្វ័យប្រវត្តិ</div>
                    </div>

                    <!-- Section A: Hongguo Website Downloads -->
                    <div id="drawerHgSectionWrap">
                        <div class="drawer-section-header">
                            <span class="drawer-section-title" id="drawerHgTitle">🎬 រឿងភាគពី Website (Hongguo)</span>
                            <span class="drawer-section-pill" id="drawerHgCount">0</span>
                        </div>
                        <!-- Active Series Queue Cards -->
                        <div id="activeSeriesContainer" style="display:flex; flex-direction:column; gap:8px;"></div>
                    </div>

                    <!-- Section B: YouTube Downloads -->
                    <div id="drawerYtSectionWrap">
                        <div class="drawer-section-header">
                            <span class="drawer-section-title" id="drawerYtTitle">▶️ វីដេអូ YouTube</span>
                            <span class="drawer-section-pill" id="drawerYtCount">0</span>
                        </div>
                        <!-- YouTube Task Cards Container in Drawer -->
                        <div id="drawerYtTasksContainer" style="display:flex; flex-direction:column; gap:8px;"></div>
                    </div>

                    <!-- Failed Episodes Box -->
                    <div id="failedEpsBox" style="display:none; background:rgba(239, 68, 68, 0.08); border:1px solid rgba(239, 68, 68, 0.28); border-radius:8px; padding:10px; margin-top:4px;">
                        <div style="font-size:0.78rem; font-weight:700; color:#fca5a5; display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                            <span id="dlFailedTitle">⚠️ ភាគដែលបរាជ័យ (Failed Episodes):</span>
                            <button class="btn-queue-retry" onclick="retryAllFailedDownloads()">🔄 Retry All</button>
                        </div>
                        <div id="failedEpsList" style="display:flex; flex-direction:column; gap:5px; max-height:130px; overflow-y:auto;"></div>
                    </div>

                    <!-- Live Activity Log -->
                    <div id="dlLogsTitle" style="font-size:0.78rem; font-weight:700; color:var(--text-muted); margin-top:4px;">
                        កំណត់ហេតុសកម្មភាព (Activity Logs):
                    </div>
                    <div class="log-box" id="dlLogBox" style="height:100px;">
                        <div>[System] Ready.</div>
                    </div>
                </div>

                <!-- 2. DOWNLOADED LIBRARY VIEW -->
                <div id="drawerLibraryView" style="display:none; flex-direction:column; gap:14px;">
                    <!-- Library Summary Stats Card -->
                    <div class="speed-panel" style="background:linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(15, 23, 42, 0.85)); border-color:rgba(16, 185, 129, 0.3);">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span style="font-size:1.3rem;">📚</span>
                                <span style="font-weight:700; font-size:0.95rem; color:#fff;" id="drawerLibSummaryTitle">សរុបឯកសារបានដោន</span>
                            </div>
                            <button class="btn btn-secondary yt-btn-sm" onclick="loadUnifiedLibrary()" style="padding:4px 10px; font-size:0.75rem;">
                                🔄 <span id="drawerLibRefreshBtn">ផ្ទុកឡើងវិញ</span>
                            </button>
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; text-align:center;">
                            <div style="background:rgba(0,0,0,0.25); padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                                <div style="font-size:0.7rem; color:var(--text-dim);" id="drawerLibStatHgLabel">រឿងភាគ</div>
                                <div style="font-size:1.15rem; font-weight:800; color:#34d399;" id="drawerStatHgCount">0</div>
                            </div>
                            <div style="background:rgba(0,0,0,0.25); padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                                <div style="font-size:0.7rem; color:var(--text-dim);" id="drawerLibStatYtLabel">YouTube</div>
                                <div style="font-size:1.15rem; font-weight:800; color:#f87171;" id="drawerStatYtCount">0</div>
                            </div>
                            <div style="background:rgba(0,0,0,0.25); padding:8px; border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                                <div style="font-size:0.7rem; color:var(--text-dim);" id="drawerLibStatDiskLabel">ទំហំផ្ទុក</div>
                                <div style="font-size:1.15rem; font-weight:800; color:#60a5fa;" id="drawerStatTotalSize">0 MB</div>
                            </div>
                        </div>
                    </div>

                    <!-- Direct Open Folder Shortcuts -->
                    <div style="display:flex; gap:8px;">
                        <button class="btn btn-secondary yt-btn-sm" style="flex:1; justify-content:center; padding:8px;" onclick="openDownloadFolder()">
                            <span>🎬</span> <span id="drawerBtnOpenHgFolder">Folder រឿងភាគ</span>
                        </button>
                        <button class="btn btn-secondary yt-btn-sm" style="flex:1; justify-content:center; padding:8px;" onclick="openYouTubeFolder()">
                            <span>▶️</span> <span id="drawerBtnOpenYtFolder">Folder YouTube</span>
                        </button>
                    </div>

                    <!-- Section 1: Hongguo Dramas in Library -->
                    <div>
                        <div class="drawer-section-header">
                            <span class="drawer-section-title" id="drawerLibHgSectionTitle">🎬 រឿងភាគដែលបានទាញយក</span>
                            <span class="drawer-section-pill" id="drawerLibHgBadge">0</span>
                        </div>
                        <div id="drawerDramaLibList" style="display:flex; flex-direction:column; gap:8px;">
                            <div style="text-align:center; padding:18px; color:var(--text-dim); font-size:0.8rem;">កំពុងផ្ទុក...</div>
                        </div>
                    </div>

                    <!-- Section 2: YouTube Videos in Library -->
                    <div>
                        <div class="drawer-section-header">
                            <span class="drawer-section-title" id="drawerLibYtSectionTitle">▶️ វីដេអូ YouTube ដែលបានទាញយក</span>
                            <span class="drawer-section-pill" id="drawerLibYtBadge">0</span>
                        </div>
                        <div id="drawerYtLibList" style="display:flex; flex-direction:column; gap:8px;">
                            <div style="text-align:center; padding:18px; color:var(--text-dim); font-size:0.8rem;">កំពុងផ្ទុក...</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Drawer Footer Action Bar -->
            <div style="padding-top:14px; border-top:1px solid var(--border-glass); display:flex; gap:8px;" id="drawerFooterActions">
                <button class="btn btn-secondary" style="flex:1; justify-content:center;" onclick="openUnifiedFolder()">
                    <span id="dlOpenFolderBtnText">📁 បើក Folder</span>
                </button>
                <button class="btn btn-secondary" id="btnRetryAllFailed" style="background:rgba(245, 158, 11, 0.15); border-color:rgba(245, 158, 11, 0.35); color:#fbbf24; font-weight:700;" onclick="retryAllFailedDownloads()" title="Retry any failed or partial episode downloads">
                    <span id="dlRetryBtnText">🔄 Retry</span>
                </button>
                <button class="btn btn-secondary" style="background:rgba(239, 68, 68, 0.15); border-color:rgba(239, 68, 68, 0.3); color:#fca5a5;" onclick="cancelAllUnifiedDownloads()">
                    <span id="dlCancelBtnText">បោះបង់ (Cancel)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Library Modal -->
    <div class="modal-overlay" id="libraryModal">
        <div class="modal-card">
            <div class="modal-header">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span>📚</span>
                    <h3 id="libraryModalTitle">បណ្ណាល័យរឿងដែលបានទាញយក (Offline Library)</h3>
                </div>
                <button class="close-btn" onclick="closeLibraryModal()">&times;</button>
            </div>
            <div class="modal-body" id="libraryBody">
                <div style="text-align:center; padding:40px; color:var(--text-dim);">កំពុងពិនិត្យ Folder...</div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="openDownloadFolder()"><span id="libOpenFolderBtnText">📁 បើក Folder ក្នុង Windows</span></button>
                <button class="btn btn-secondary" onclick="closeLibraryModal()"><span id="libCloseBtnText">បិទ</span></button>
            </div>
        </div>
    </div>

    <!-- Settings Modal -->
    <div class="modal-overlay" id="settingsModal">
        <div class="modal-card" style="max-width:540px;">
            <div class="modal-header">
                <h3 id="settingsModalTitle">⚙️ ការកំណត់ប្រព័ន្ធ (Settings)</h3>
                <button class="close-btn" onclick="closeSettingsModal()">&times;</button>
            </div>
            <div class="modal-body" style="display:flex; flex-direction:column; gap:18px;">
                <div>
                    <label id="settingsOutDirLabel" style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:6px;">ទីតាំងរក្សាទុកវីដេអូ (Download Output Directory):</label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" class="range-input" id="settingsOutDir" style="font-size:0.82rem;" readonly>
                        <button class="btn btn-secondary" onclick="browseDownloadFolder()"><span id="settingsBrowseBtnText">ផ្លាស់ប្ដូរ...</span></button>
                    </div>
                </div>
                <div>
                    <label id="settingsThreadsLabel" style="display:block; font-size:0.85rem; font-weight:700; margin-bottom:6px;">ចំនួន Threads ទាញយកស្របគ្នា (Threads):</label>
                    <input type="number" class="range-input" id="settingsThreads" min="1" max="16" value="4">
                </div>
                <div style="background:rgba(255, 255, 255, 0.03); border:1px solid var(--border-glass); border-radius:8px; padding:12px; font-size:0.8rem; color:var(--text-dim);">
                    <div>• <b>Application:</b> Hongguo Downloader V3</div>
                    <div>• <b>Data Source:</b> https://hongguoduanju.com/ (SSR Scraper)</div>
                    <div>• <b>Video Stream:</b> Direct unencrypted MP4 CDN (HTTP 206 Partial Content)</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeSettingsModal()"><span id="settingsCancelBtnText">បោះបង់</span></button>
                <button class="btn btn-primary" onclick="saveSystemSettings()"><span id="settingsSaveBtnText">រក្សាទុក (Save)</span></button>
            </div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toastContainer"></div>

