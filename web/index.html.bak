                                </h1>
                                <p class="hs-hero-subtitle" id="hsHeroSubtitle">
                                    រឿងភាគខ្លីចិនរាប់ម៉ឺនរឿង មើលនិងទាញយកឥតគិតថ្លៃ (10,000+ Free Short Dramas, Full HD 1080p)
                                </p>
                            </div>
                        </div>
                        <button type="button" class="hs-btn-website" onclick="openHaoSouWebsite()" title="បើកវេបសាយ dj.1dfx.com ក្នុង Browser">
                            <span>🌐</span>
                            <span id="hsOpenSiteLabel">ចូលទៅកាន់វេបសាយផ្ទាល់ (1dfx.com) ↗</span>
                        </button>
                    </div>

                    <!-- URL / Search Input Box -->
                    <div class="hs-search-box-card">
                        <div class="hs-search-input-wrapper">
                            <span class="hs-input-icon">
                                🎬
                            </span>
                            <input type="text" id="hsDramaInput" class="hs-main-input" placeholder="ស្វែងរករឿងភាគខ្លី (Chinese Drama) ឬបិទភ្ជាប់លីង (https://dj.1dfx.com/v/newlist.php?book_id=... ឬ ID)" onkeydown="onHsInputKeyDown(event)" autocomplete="off" spellcheck="false">
