                                <span id="hsEpisodeCount" style="color:#818cf8; font-weight:700;">0</span>
                            </span>
                            <span id="hsCurrentPlayingEp" style="font-size:0.8rem; color:#38bdf8;"></span>
                        </div>
                        <div class="hs-ep-grid nice-scroll" id="hsEpisodeGrid">
                            <!-- Episodes injected dynamically -->
                        </div>
                    </div>

                    <!-- Download Options -->
                    <div style="margin-top:16px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-size:0.84rem; color:#94a3b8;">📂 រក្សាទុកនៅ:</span>
                            <span id="hsOutputDirDisplay" style="font-size:0.82rem; color:#38bdf8; font-family:monospace; background:rgba(0,0,0,0.3); padding:4px 8px; border-radius:6px; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">...</span>
                            <button type="button" class="btn btn-secondary" onclick="pickHsFolder()" style="padding:4px 10px; font-size:0.8rem; border-radius:6px;">ប្តូរ</button>
                        </div>
                        <button type="button" class="hs-dl-btn" id="btnHsDownload" onclick="startHsBatchDownload()">
                            <span>⬇️</span>
                            <span id="hsDownloadBtnText">ទាញយកភាគទាំងអស់ (Download All)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Recommendations / Search Results Section -->
            <div class="hs-section-header">
                <h2 class="hs-section-title">
                    <span id="hsSectionIcon">🔥</span>
                    <span id="hsSectionTitle">រឿងភាគពេញនិយម (Hot Recommendations)</span>
                </h2>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn btn-secondary" id="btnHsBackToRecs" onclick="loadHaoSouRecommendations('all')" style="display:none; font-size:0.84rem; padding:6px 14px; border-radius:8px;">
                        <span id="btnHsBackToRecsText">← ត្រឡប់ទៅរឿងពេញនិយម</span>
                    </button>
