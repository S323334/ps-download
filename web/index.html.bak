                <button type="button" class="hs-cat-chip" data-cat="action" onclick="selectHaoSouCategory('action')">
                    <span>⚔️</span> <span id="hsCatAction">វាយបក (Action)</span>
                </button>
                <button type="button" class="hs-cat-chip" data-cat="rebirth" onclick="selectHaoSouCategory('rebirth')">
