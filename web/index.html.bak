                </button>
                <button type="button" class="hs-cat-chip" data-cat="romance" onclick="selectHaoSouCategory('romance')">
                    <span>💖</span> <span id="hsCatRomance">ស្នេហា (Romance)</span>
                </button>
                <button type="button" class="hs-cat-chip" data-cat="historical" onclick="selectHaoSouCategory('historical')">
                    <span>🏮</span> <span id="hsCatHist">បុរាណ (Historical)</span>
