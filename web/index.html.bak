                                <svg viewBox="0 0 24 24" width="30" height="30" fill="none">
                                    <path d="M9.5 8L16.5 12L9.5 16V8Z" fill="#FFFFFF"/>
                                    <circle cx="12" cy="12" r="10" stroke="#FFFFFF" stroke-width="2"/>
